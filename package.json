{
  "name": "lattice",
  "version": "0.1.0",
  "description": "Lattice — 局域网 P2P 文件共享工具 (Electron + Element Plus + SQLite)",
  "main": "./out/main/index.js",
  "author": {
    "name": "Lattice",
    "email": "lattice@example.com"
  },
  "homepage": "https://github.com/lattice/lattice",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview --noSandbox",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "element-plus": "^2.14.8",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
